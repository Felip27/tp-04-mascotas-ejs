<section>
    <h1>Registrar Nueva Mascota</h1>

    <% if (error) { %>
        <div class="mensaje-error" role="alert">
            <%= error %>
        </div>
    <% } %>

    <form action="/mascotas" method="post" class="formulario">
        <div class="campo-formulario">
            <label for="nombre">Nombre</label>
            <input type="text" id="nombre" name="nombre" value="<%= valores.nombre %>">
        </div>

        <div class="campo-formulario">
            <label for="especie">Especie</label>
            <input type="text" id="especie" name="especie" value="<%= valores.especie %>">
        </div>

        <div class="campo-formulario">
            <label for="edad">Edad (años)</label>
            <input type="number" id="edad" name="edad" min="0" value="<%= valores.edad %>">
        </div>

        <div class="campo-formulario">
            <label for="estado">Estado</label>
            <select id="estado" name="estado">
                <option value="En adopción" <%= valores.estado === 'En adopción' ? 'selected' : '' %>>En adopción</option>
                <option value="Reservada" <%= valores.estado === 'Reservada' ? 'selected' : '' %>>Reservada</option>
                <option value="Adoptada" <%= valores.estado === 'Adoptada' ? 'selected' : '' %>>Adoptada</option>
            </select>
        </div>

        <div class="campo-formulario">
            <label for="descripcion">Descripción</label>
            <textarea id="descripcion" name="descripcion" rows="4"><%= valores.descripcion %></textarea>
        </div>

        <button type="submit" class="boton-principal">Guardar mascota</button>
    </form>
</section>
